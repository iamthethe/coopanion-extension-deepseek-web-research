{
  "name": "cortico-world-deepseeksearch",
  "version": "0.1.1",
  "type": "module",
  "description": "DeepSeek 网页搜索与 Markdown 抓取，兼容 Cortico World API 6",
  "license": "MIT",
  "keywords": [
    "cortico-world",
    "cortico"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "DeepSeek 网页搜索",
    "tags": [],
    "describe": "describe.json"
  },
  "files": [
    "src/**/*.ts",
    "src/**/*.md",
    "scripts",
    "README.md",
    "VALIDATION.md",
    "CHANGELOG.md",
    "describe.json"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
